  "flowDefinitions": [
    {
      "id": "mileageCalculator",
      "name": "mileageCalculator",
      "flowSteps": [
        {
          "id": "start",
          "transitions": [
            {
              "order": "a",
              "value": "createExpense",
              "condition": "true"
            }
          ],
          "startsFlow": true,
          "taskId": "root"
        },
        {
          "id": "createExpense",
          "transitions": [
            {
              "order": "a",
              "value": "confirmation",
              "condition": "<% queryParams.submitConfirmation == '1' %>"
            },
            {
              "order": "b",
              "value": "searchAgain",
              "condition": "<% queryParams.searchAgain == '1' %>"
            }
          ],
          "taskId": "createExpense"
        },
        {
          "id": "searchAgain",
          "endsFlow": true,
          "taskId": "root"
        },
        {
          "id": "confirmation",
          "endsFlow": true,
          "taskId": "confirmation"
        }
      ]
    }
  ],
  "tasks": [
    {
      "id": "root",
      "routingPattern": "/",
